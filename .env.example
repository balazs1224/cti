# Local development only. Use synthetic values.
APP_ENV=development
LOG_LEVEL=INFO

# Internal application database
DATABASE_URL=postgresql+psycopg://cti:change-me@postgres:5432/cti

# Queue and cache
REDIS_URL=redis://redis:6379/0

# Internal API
INTERNAL_API_BASE_URL=http://api:8000
INTERNAL_API_AUTH_MODE=development

# n8n local development
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-local-development-value

# Threat-intelligence adapter
TI_ADAPTER_TYPE=mock
OPENCTI_BASE_URL=http://mock-opencti:8080
OPENCTI_TOKEN=synthetic-placeholder

# SIEM adapter
SIEM_ADAPTER_TYPE=mock
SIEM_BASE_URL=http://mock-siem:8081
SIEM_TOKEN=synthetic-placeholder

# Enrichment adapter
ENRICHMENT_ADAPTER_TYPE=mock
ENRICHMENT_TOKEN=synthetic-placeholder

# Notification adapter
NOTIFICATION_ADAPTER_TYPE=webhook
NOTIFICATION_WEBHOOK_URL=http://mock-notification:8082/events

# Never add real customer credentials or production endpoints to this file.
